# 1740 B, so raising it implicitly cost +8.7 KB SRAM (88.7% -> 90.4%).
# Pin the L2CAP pool at its previous size: the PAN path uses its own
# pan_tx_pool, and SRAM must stay free for the 31 KB minimp3 decoder.
CONFIG_BT_L2CAP_TX_BUF_COUNT=8
