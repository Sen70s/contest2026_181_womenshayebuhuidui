# Opus codec (2026-10-14)
# Why: 16kHz/16bit raw PCM is 32KB/s but the BT PAN uplink ceiling is ~12KB/s
# (ACL in-flight window x fragments x RTT), so raw PCM can never stream in real
# time. Opus at 16kbps is 2KB/s, i.e. 1/6 of the ceiling.
# Real measurement on the board (opus_demo encoding a 4.096s recording):
#   complexity 0  -> 2s  = 2.05x realtime  (can encode while recording)
#   complexity 10 -> 6s  = 0.68x realtime  (good for offline encode)
# NOTE: the library is built with -O2 explicitly (see external/opus/CMakeLists.txt);
# without it everything was -O0 and 3x slower (0.68x realtime at complexity 0).
# Validation-only switches, not needed in a shipping image:
#   CONFIG_LIB_OPUS_DEMO=y        -> opus_demo encoder CLI (used for the numbers above)
#   CONFIG_LIB_OPUS_ENCODE_TEST=y -> opus_enctest. It CRASHES on this board, but the
#     fault is in the test itself: mscbr_encode_fail10() has a 627300-byte array on
#     the stack, sized for an 8MB host stack. Not an Opus bug.
CONFIG_LIB_OPUS=y
CONFIG_LIB_OPUS_STACKSIZE=102400
CONFIG_LIB_OPUS_PRIORITY=80

# MPU6050 6-axis IMU (2026-10-22)
# Uses the FREE I2C3 instance, muxed to PA00(SCL) / PA01(SDA).
# Do NOT share I2C1 (touch, PA30/PA33) or I2C2 (MAX30102, PA41/PA42):
# each I2C instance has one xxx_PINR register selecting exactly one pad
# pair, so taking one over kicks the existing device off the bus.
# PA00/PA01 are set in bsp_pinmux.c as GPIO_A0 / GPTIM1_CH4 (comments
# mention LCD reset and backlight PWM) but NOTHING in the tree drives
# either pad: panel reset uses the CO5300 software reset command and
# brightness uses DCS 0x51, not PWM.
CONFIG_BSP_USING_I2C3=y
# CONFIG_BSP_I2C3_USING_DMA is not set
CONFIG_SENSORS_MPU60X0=y
CONFIG_MPU60X0_I2C=y
# Both values MUST live here (defconfig), not in a hand-edited .config:
# every cmake reconfigure regenerates .config from this file + Kconfig
# defaults and would silently revert them.
#   Measured 2026-10-24: with AFS_SEL back at its default 2 (+-8g) the rest
#   magnitude dropped 8400 -> 4210 and every pedometer threshold became 2x
#   too large, because pedometer.c works in raw LSB.
#
# 50000: this board has no external I2C pull-ups; SiFli's I2C app note says
#        stay below 100k when relying on internal pull-ups. 400k fails.
CONFIG_MPU60X0_I2C_FREQ=50000
# 1 = +-4g (8192 LSB/g). pedometer.c thresholds are raw-LSB values tuned for
#     this range; changing it requires retuning them.
CONFIG_MPU60X0_ACCEL_AFS_SEL=1

# BT HCI mailbox rings: MPU non-cacheable (fix drop invalid h4, docs 30 sec 22 root cause 2)
CONFIG_ARM_MPU=y
CONFIG_ARM_MPU_NREGIONS=8


# TCP: 修复 BT PAN 下的丢包恢复慢(无 SACK/乱序时每次丢包等 RTO, 真机 TTS 下载呈 4-5s 突发间隔)
CONFIG_NET_TCP_OUT_OF_ORDER=y
CONFIG_NET_TCP_OUT_OF_ORDER_BUFSIZE=16384
CONFIG_NET_TCP_SELECTIVE_ACK=y

