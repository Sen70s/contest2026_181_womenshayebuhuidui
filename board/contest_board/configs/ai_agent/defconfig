# Time sync is done by src/infra/time_sync.c, not apps/netutils/ntpclient:
# that daemon gates every attempt on netlib_check_ipconnectivity(NULL, 1, 1) --
# one ICMP echo to the DNS nameserver with a 1 s deadline -- which fails often
# enough over Bluetooth PAN that it never collects a sample (observed: 3 min of
# backoff while `ping -c 4 223.5.5.5` was 4/4 at the same moment), and it
# compiles its diagnostics out so the log says nothing.
# CONFIG_NETUTILS_NTPCLIENT is not set
# Android's tethering dnsmasq answers DISCOVER with a *unicast* OFFER addressed
# to the yiaddr it just picked (192.168.44.x). bt-pan still has 0.0.0.0 at that
# point, so ipv4_input() has nothing to match it against. RFC 1542 says a
# client that cannot receive unicast before being configured must set the
# BROADCAST flag; then the OFFER/ACK arrive at 255.255.255.255 and are accepted.
CONFIG_NETUTILS_DHCPC_BOOTP_FLAGS=0x8000

# R77: full BNEP Ethernet PDU in zblue global ACL pool (removes corrupt dedicated PAN pool)
# TX_MTU raised to 1691: acl_tx_pool is sized by BT_L2CAP_BUF_SIZE(TX_MTU),
# and BNEP data frames need up to 1691 bytes. The old comment about "never
# CONFIG_BT_L2CAP_TX_MTU=1691  (set at line 233, no duplicate needed)
# A NAP peer may send us a full 1691-byte BNEP PDU. At the old 1025 the ACL
# reassembly buffer truncated large inbound frames, which shows up as stalled
# TCP downloads rather than an obvious error. 1695 = 1691 + 4 bytes of L2CAP
# header. Paired with RX_COUNT_EXTRA=2 above so the pool does not balloon.
CONFIG_BT_BUF_ACL_RX_SIZE=1695
# Class of Device. The frameworks Kconfig symbol used to be named
# CONFIG_BLUETOOTH_DEFAULT_COD, which made kconfig emit
# CONFIG_CONFIG_BLUETOOTH_DEFAULT_COD and left the header-side
# #ifdef CONFIG_BLUETOOTH_DEFAULT_COD unreachable - the value below had no
# effect and the build fell back to the Kconfig default 0x00280704.
# The symbol is renamed to BLUETOOTH_DEFAULT_COD on the #591 branch, so this
# single-prefix line is what takes effect now.
# 0x002A0704 = Networking(0x020000) + Audio(0x200000) + Capturing(0x080000)
# + Wearable/Wristwatch(0x000704). Phones read the Networking bit to decide
# whether to offer tethering, so PAN needs it set.
CONFIG_BLUETOOTH_DEFAULT_COD=0x002A0704

