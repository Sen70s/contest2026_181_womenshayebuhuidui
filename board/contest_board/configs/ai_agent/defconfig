# Bluetooth throughput (2026-10-12): one 1500 B PAN frame needs 4 ACL
# fragments of 487 B, but the global in-flight window was min(fragments=2,
# TX_MAX=5, br.pkts=4, in_ll<3) = 2 -> ~12 KB/s and zblue dropped frames
# ("Unable to allocate buffer within timeout"), truncating TTS audio.
# Raise the three host-side knobs (+~312 B RAM total; srpkt credits come
# from the driver's synthesised Read_Buffer_Size, raised 4 -> 8 there).
CONFIG_BT_CONN_FRAG_COUNT=8
CONFIG_BT_BUF_ACL_TX_COUNT=10
CONFIG_BT_CONN_TX_MAX=10
